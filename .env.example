# Settings for docker-compose.yml. Copy to `.env` (gitignored) and fill in.
# Generate random values with:  openssl rand -hex 32

# InfluxDB — first-start setup; the token is also what the services use.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_TOKEN=
INFLUXDB_ORG=tankwatch
INFLUXDB_BUCKET=tankwatch

# Mosquitto user the consumer service logs in as. It must also exist in the
# `mosquitto_passwords` file (see README > Deployment).
MQTT_CONSUMER_PASSWORD=
